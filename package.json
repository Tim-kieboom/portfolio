{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "build:css": "sass --no-source-map --style=compressed src/styles/main.scss dist/main.css",
    "build:js": "tsc",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "sass --watch src/styles/main.scss dist/main.css",
    "watch:js": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "typescript": "^5.6.0"
  }
}
